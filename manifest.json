{
  "manifest_version": 3,
  "name": "Nezvi WoW Extension",
  "short_name": "Nezvi WoW",
  "version": "1.2",
  "description": "Your character's Raider.io, Warcraft Logs, Armory and more, one click away.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Open Nezvi WoW"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://raider.io/*"
  ]
}
